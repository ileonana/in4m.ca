---
// Add or remove places here; the client script reads them from the markup.
const groups = [
	{
		title: 'North America',
		places: [
			{ name: 'Toronto', lat: 43.6532, lon: -79.3832 },
			{ name: 'Maple', lat: 43.8595, lon: -79.507 },
		],
	},
	{
		title: 'China',
		places: [
			{ name: 'Taiyuan', zh: '太原', lat: 37.8706, lon: 112.5489 },
			{ name: 'Sanya', zh: '三亚', lat: 18.2528, lon: 109.512 },
		],
	},
];
---

<section class="tile weather" id="weather" aria-label="Weather">
	<div class="layout">
	{
		groups.map((g) => (
			<div class="group">
				<h2 class="group-title">{g.title}</h2>
				<div class="cells">
					{g.places.map((p) => (
						<div class="cell" data-lat={p.lat} data-lon={p.lon}>
							<div class="label">
								{p.name}
								{p.zh && <span>{p.zh}</span>}
							</div>
							<div class="now">
								<span class="icon" data-role="icon" aria-hidden="true"></span>
								<span class="temp num" data-role="temp">–</span>
							</div>
							<div class="cond" data-role="cond">Loading…</div>
							<div class="range" data-role="range" />
						</div>
					))}
				</div>
			</div>
		))
	}
	<div class="foot" data-role="updated"></div>
	</div>
</section>

<script>
	const REFRESH_MS = 15 * 60 * 1000; // Open-Meteo updates current conditions every 15 min
	const CACHE_KEY = 'weather-v1';

	// Minimal line icons (24x24, stroked with currentColor).
	const CLOUD = 'M6.5 18.5h10.25a3.75 3.75 0 0 0 .5-7.46A5.5 5.5 0 0 0 6.7 12.2a3.2 3.2 0 0 0-.2 6.3z';
	const CLOUD_HIGH = 'M6.5 14.5h10.25a3.75 3.75 0 0 0 .5-7.46A5.5 5.5 0 0 0 6.7 8.2a3.2 3.2 0 0 0-.2 6.3z';
	const icons: Record<string, string> = {
		sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
		moon: '<path d="M20 14.2A8 8 0 0 1 9.8 4a8 8 0 1 0 10.2 10.2z"/>',
		partlyDay: `<circle cx="8.5" cy="8.5" r="2.6"/><path d="M8.5 3v1M3 8.5h1M4.6 4.6l.7.7M12.4 4.6l-.7.7"/><path d="M9 20h8a3.2 3.2 0 0 0 .4-6.4 4.5 4.5 0 0 0-8.6 1A2.7 2.7 0 0 0 9 20z"/>`,
		partlyNight: `<path d="M11.5 4.3a4 4 0 1 0 4 5 3.6 3.6 0 0 1-4-5z"/><path d="M9 20h8a3.2 3.2 0 0 0 .4-6.4 4.5 4.5 0 0 0-8.6 1A2.7 2.7 0 0 0 9 20z"/>`,
		cloud: `<path d="${CLOUD}"/>`,
		fog: '<path d="M4 8.5h16M6.5 12.5h11M4 16.5h16"/>',
		drizzle: `<path d="${CLOUD_HIGH}"/><path d="M8 18l-.6 1.6M12 18l-.6 1.6M16 18l-.6 1.6"/>`,
		rain: `<path d="${CLOUD_HIGH}"/><path d="M8 17.5l-1 2.8M12 17.5l-1 2.8M16 17.5l-1 2.8"/>`,
		snow: `<path d="${CLOUD_HIGH}"/><path d="M8 18v.01M12 19.5v.01M16 18v.01M10 21v.01M14 21v.01" stroke-width="2.2"/>`,
		storm: `<path d="${CLOUD_HIGH}"/><path d="M12.8 14.5l-2.3 3.2h3l-2.3 3.3"/>`,
	};
	const svg = (key: string) =>
		`<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">${icons[key] ?? ''}</svg>`;

	// WMO weather codes -> [day icon, night icon, label]
	const codes: Record<number, [string, string, string]> = {
		0: ['sun', 'moon', 'Clear'],
		1: ['sun', 'moon', 'Mostly clear'],
		2: ['partlyDay', 'partlyNight', 'Partly cloudy'],
		3: ['cloud', 'cloud', 'Overcast'],
		45: ['fog', 'fog', 'Fog'],
		48: ['fog', 'fog', 'Freezing fog'],
		51: ['drizzle', 'drizzle', 'Light drizzle'],
		53: ['drizzle', 'drizzle', 'Drizzle'],
		55: ['drizzle', 'drizzle', 'Heavy drizzle'],
		56: ['drizzle', 'drizzle', 'Freezing drizzle'],
		57: ['drizzle', 'drizzle', 'Freezing drizzle'],
		61: ['rain', 'rain', 'Light rain'],
		63: ['rain', 'rain', 'Rain'],
		65: ['rain', 'rain', 'Heavy rain'],
		66: ['rain', 'rain', 'Freezing rain'],
		67: ['rain', 'rain', 'Freezing rain'],
		71: ['snow', 'snow', 'Light snow'],
		73: ['snow', 'snow', 'Snow'],
		75: ['snow', 'snow', 'Heavy snow'],
		77: ['snow', 'snow', 'Snow grains'],
		80: ['rain', 'rain', 'Showers'],
		81: ['rain', 'rain', 'Showers'],
		82: ['storm', 'storm', 'Violent showers'],
		85: ['snow', 'snow', 'Snow showers'],
		86: ['snow', 'snow', 'Heavy snow showers'],
		95: ['storm', 'storm', 'Thunderstorm'],
		96: ['storm', 'storm', 'Thunderstorm, hail'],
		99: ['storm', 'storm', 'Thunderstorm, hail'],
	};

	type Place = {
		current: { temperature_2m: number; apparent_temperature: number; weather_code: number; is_day: number };
		daily: {
			temperature_2m_max: number[];
			temperature_2m_min: number[];
			precipitation_probability_max: (number | null)[];
		};
	};
	type Cached = { at: number; data: Place[] };

	const root = document.getElementById('weather')!;
	const cells = [...root.querySelectorAll<HTMLElement>('.cell')];
	const q = (el: Element, role: string) => el.querySelector<HTMLElement>(`[data-role="${role}"]`)!;

	function readCache(): Cached | null {
		try {
			const c = JSON.parse(localStorage.getItem(CACHE_KEY) ?? 'null') as Cached | null;
			return c && c.data.length === cells.length ? c : null;
		} catch {
			return null;
		}
	}
	function writeCache(c: Cached) {
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify(c));
		} catch {}
	}

	const deg = (n: number) => `${Math.round(n)}°`;

	function render({ at, data }: Cached, stale = false) {
		cells.forEach((cell, i) => {
			const w = data[i];
			const [day, night, label] = codes[w.current.weather_code] ?? ['cloud', 'cloud', '—'];
			q(cell, 'icon').innerHTML = svg(w.current.is_day ? day : night);
			q(cell, 'temp').textContent = deg(w.current.temperature_2m);
			q(cell, 'cond').textContent = label;
			const feels = Math.round(w.current.apparent_temperature);
			const rain = w.daily.precipitation_probability_max[0];
			// Each chunk is nowrap so narrow cells wrap between chunks, never inside one.
			const chunks = [
				feels !== Math.round(w.current.temperature_2m) ? `feels ${feels}°` : '',
				`H ${deg(w.daily.temperature_2m_max[0])} L ${deg(w.daily.temperature_2m_min[0])}`,
				rain != null ? `${rain}% rain` : '',
			].filter(Boolean);
			q(cell, 'range').replaceChildren(
				...chunks.map((t) => Object.assign(document.createElement('span'), { textContent: t })),
			);
		});
		const time = new Date(at).toLocaleTimeString('en-CA', {
			timeZone: 'America/Toronto',
			hour: 'numeric',
			minute: '2-digit',
		});
		const note = q(root, 'updated');
		note.classList.toggle('stale', stale);
		note.textContent = stale ? `Couldn't refresh · last updated ${time}` : `Updated ${time} · Open-Meteo`;
	}

	async function refresh() {
		const cached = readCache();
		if (cached && Date.now() - cached.at < REFRESH_MS) {
			render(cached);
			return;
		}
		const url = new URL('https://api.open-meteo.com/v1/forecast');
		url.search = new URLSearchParams({
			latitude: cells.map((c) => c.dataset.lat).join(','),
			longitude: cells.map((c) => c.dataset.lon).join(','),
			current: 'temperature_2m,apparent_temperature,weather_code,is_day',
			daily: 'temperature_2m_max,temperature_2m_min,precipitation_probability_max',
			timezone: 'auto',
			forecast_days: '1',
		}).toString();
		try {
			const res = await fetch(url);
			if (!res.ok) throw new Error(String(res.status));
			const fresh: Cached = { at: Date.now(), data: await res.json() };
			writeCache(fresh);
			render(fresh);
		} catch {
			if (cached) render(cached, true);
			else for (const cell of cells) q(cell, 'cond').textContent = 'Unavailable';
		}
	}

	refresh();
	setInterval(refresh, REFRESH_MS);
	// Timers are throttled in background tabs, so also refresh when the tab comes back.
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) refresh();
	});
</script>

<style>
	.tile {
		container-type: inline-size;
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem 2.5rem;
	}
	.group {
		min-width: 0;
	}
	.group + .group {
		border-top: 1px solid var(--line);
		padding-top: 1.25rem;
	}
	.cells {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.75rem;
	}
	.cell {
		min-width: 0;
	}
	.cell + .cell {
		border-left: 1px solid var(--line);
		padding-left: 1.75rem;
	}
	/* Layout follows the tile's own width, not the viewport: groups sit side by side only when there is room. */
	@container (min-width: 58rem) {
		.layout {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.group + .group {
			border-top: 0;
			padding-top: 0;
			border-left: 1px solid var(--line);
			padding-left: 2.5rem;
		}
	}
	.label span {
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: none;
	}
	.now {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.35rem 0 0.2rem;
	}
	.icon {
		display: inline-flex;
		color: var(--muted);
	}
	.cond {
		font-size: 0.85rem;
	}
	.range {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.7rem;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.range :global(span) {
		white-space: nowrap;
	}
	.foot {
		grid-column: 1 / -1;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		text-align: right;
		opacity: 0.8;
	}
	.foot.stale {
		color: var(--danger);
		opacity: 1;
	}
</style>
