---
import schedule from '../data/go-barrie.json';
import T from './T.astro';
---

<section class="tile go" id="go-train" aria-labelledby="go-title">
	<header>
		<h2 class="group-title" id="go-title"><T zh="GO 火车 · 巴里线">GO Train · Barrie line</T></h2>
		<span class="sub" lang="en">Maple ⇄ Union</span>
	</header>

	<div class="dirs">
		<div class="dir" data-dir="toUnion">
			<div class="route label"><T zh="枫树镇">Maple</T> <span>→</span> <T zh="联合车站">Union</T></div>
			<div class="next num" data-role="next">–</div>
			<div class="eta" data-role="eta"></div>
			<div class="then" data-role="then"></div>
		</div>
		<div class="dir" data-dir="toMaple">
			<div class="route label"><T zh="联合车站">Union</T> <span>→</span> <T zh="枫树镇">Maple</T></div>
			<div class="next num" data-role="next">–</div>
			<div class="eta" data-role="eta"></div>
			<div class="then" data-role="then"></div>
		</div>
	</div>

	<footer data-role="updated" data-generated={schedule.generated} data-end={schedule.feedEnd}></footer>

	<script type="application/json" id="go-schedule" set:html={JSON.stringify(schedule.days)} />
</section>

<script>
	import { lang, locale, onLang } from '../i18n';

	type Train = { dep: string; arr: string };
	type Day = { toUnion: Train[]; toMaple: Train[] };

	const days: Record<string, Day> = JSON.parse(
		document.getElementById('go-schedule')!.textContent!,
	);

	const tz = 'America/Toronto';
	const parts = new Intl.DateTimeFormat('en-CA', {
		timeZone: tz,
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
		hour: '2-digit',
		minute: '2-digit',
		hourCycle: 'h23',
	});

	// Toronto wall-clock "now" as minutes since epoch, treating wall time as UTC.
	function torontoNow() {
		const p = Object.fromEntries(parts.formatToParts(new Date()).map((x) => [x.type, x.value]));
		return {
			date: `${p.year}-${p.month}-${p.day}`,
			minutes: Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute) / 60000,
		};
	}

	function shiftDate(date: string, delta: number) {
		const d = new Date(date + 'T00:00:00Z');
		d.setUTCDate(d.getUTCDate() + delta);
		return d.toISOString().slice(0, 10);
	}

	// Minutes since epoch (wall-clock) for a service date + "HH:MM" (may be >= 24:00).
	function at(date: string, hhmm: string) {
		const [h, m] = hhmm.split(':').map(Number);
		return new Date(date + 'T00:00:00Z').getTime() / 60000 + h * 60 + m;
	}

	const L = {
		en: {
			// "7:05 pm"
			clock: (h: number, mm: string) => `${h % 12 || 12}:${mm} ${h >= 12 ? 'pm' : 'am'}`,
			now: 'departing now',
			mins: (m: number) => `in ${m} min`,
			hours: (h: number, m: number) => `in ${h} h ${m} min`,
			tomorrow: 'Tomorrow · ',
			arrives: (t: string) => `arrives ${t}`,
			laterTomorrow: 'tomorrow ',
			then: (list: string) => `Then ${list}`,
			none: 'No trains',
			ending: 'Schedule ends soon, check back later',
			ended: (when: string) => `Timetable ended · last updated ${when}`,
			stale: (when: string) => `Couldn't refresh timetable · last updated ${when}`,
			ok: (when: string) => `Scheduled times · timetable updated ${when} · no live delays yet`,
		},
		zh: {
			// "19:05"
			clock: (h: number, mm: string) => `${String(h).padStart(2, '0')}:${mm}`,
			now: '即将发车',
			mins: (m: number) => `${m} 分钟后`,
			hours: (h: number, m: number) => `${h} 小时 ${m} 分钟后`,
			tomorrow: '明天 · ',
			arrives: (t: string) => `${t} 到达`,
			laterTomorrow: '明天 ',
			then: (list: string) => `之后 ${list}`,
			none: '暂无车次',
			ending: '时刻表即将结束，请稍后再查看',
			ended: (when: string) => `时刻表已过期 · 上次更新 ${when}`,
			stale: (when: string) => `时刻表刷新失败 · 上次更新 ${when}`,
			ok: (when: string) => `计划时间 · 时刻表更新于 ${when} · 暂无实时晚点信息`,
		},
	};
	const l = () => L[lang()];

	function clock(hhmm: string) {
		const [h, m] = hhmm.split(':').map(Number);
		return l().clock(h % 24, String(m).padStart(2, '0'));
	}

	function upcoming(dir: keyof Day, now: { date: string; minutes: number }) {
		const out: { dep: number; train: Train }[] = [];
		// Yesterday's service can run past midnight; tomorrow covers late-night lookups.
		for (const d of [shiftDate(now.date, -1), now.date, shiftDate(now.date, 1)]) {
			for (const train of days[d]?.[dir] ?? []) {
				const dep = at(d, train.dep);
				if (dep >= now.minutes) out.push({ dep, train });
			}
		}
		return out.sort((a, b) => a.dep - b.dep);
	}

	function eta(mins: number) {
		if (mins <= 0) return l().now;
		if (mins < 60) return l().mins(mins);
		return l().hours(Math.floor(mins / 60), mins % 60);
	}

	function render() {
		const now = torontoNow();
		for (const el of document.querySelectorAll<HTMLElement>('#go-train .dir')) {
			const list = upcoming(el.dataset.dir as keyof Day, now);
			const q = (role: string) => el.querySelector<HTMLElement>(`[data-role="${role}"]`)!;
			const first = list[0];
			if (!first) {
				q('next').textContent = l().none;
				q('eta').textContent = l().ending;
				q('then').textContent = '';
				continue;
			}
			// Which service day a departure falls on, relative to today (0 = today, 1 = tomorrow).
			const dayOf = (x: { dep: number }) => Math.floor((x.dep - at(now.date, '00:00')) / 1440);
			q('next').textContent = clock(first.train.dep);
			q('eta').textContent =
				`${dayOf(first) > 0 ? l().tomorrow : ''}${eta(first.dep - now.minutes)} · ${l().arrives(clock(first.train.arr))}`;
			const later = list.slice(1, 4).map((x, i) => {
				const prev = list[i]; // the departure just before this one
				return `${dayOf(x) > dayOf(prev) ? l().laterTomorrow : ''}${clock(x.train.dep)}`;
			});
			q('then').textContent = later.length ? l().then(later.join(' · ')) : '';
		}
	}

	// Footer: when the timetable was last refreshed; red if the daily refresh has been failing.
	function renderFooter() {
		const el = document.querySelector<HTMLElement>('#go-train [data-role="updated"]')!;
		const generated = new Date(el.dataset.generated!);
		const when = new Intl.DateTimeFormat(locale(), {
			timeZone: tz,
			month: 'short',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
		}).format(generated);
		const ended = torontoNow().date > el.dataset.end!;
		const stale = ended || Date.now() - generated.getTime() > 30 * 3600_000; // daily refresh + slack
		el.classList.toggle('stale', stale);
		el.textContent = ended ? l().ended(when) : stale ? l().stale(when) : l().ok(when);
	}

	function update() {
		render();
		renderFooter();
	}
	update();
	setInterval(update, 15_000);
	onLang(update);
</script>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.group-title {
		margin: 0;
	}
	.sub,
	footer {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}
	.dirs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 0.9rem;
	}
	.dir {
		background: var(--inset);
		border: 1px solid var(--line);
		border-radius: 1.1rem;
		padding: 1.1rem 1.25rem;
	}
	.route span {
		letter-spacing: 0;
		margin: 0 0.15rem;
	}
	.next {
		margin: 0.35rem 0 0.2rem;
	}
	.eta {
		font-size: 0.85rem;
	}
	.then {
		margin-top: 0.4rem;
		font-size: 0.75rem;
		color: var(--muted);
	}
	footer {
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		opacity: 0.85;
	}
	footer:lang(zh) {
		font-size: 0.72rem;
		letter-spacing: 0.02em;
	}
	footer.stale {
		color: var(--danger);
		opacity: 1;
	}
</style>
