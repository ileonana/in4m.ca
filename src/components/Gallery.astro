---
import { Image, getImage } from 'astro:assets';

// Drop image files into src/assets/photos; they are sorted by filename.
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/photos/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);

const photos = await Promise.all(
	Object.entries(modules)
		.sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
		.map(async ([path, mod]) => {
			const full = await getImage({ src: mod.default, width: 2000, format: 'webp' });
			const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
			const ratio = mod.default.width / mod.default.height;
			return { src: mod.default, full: full.src, alt: name.replace(/[-_]+/g, ' '), portrait: ratio < 1 };
		}),
);
---

<div class="gallery">
	{
		photos.map((p, i) => (
			<button type="button" class:list={['tile', p.portrait ? 'portrait' : 'landscape']} data-full={p.full} data-alt={p.alt} aria-label={`Open photo ${i + 1}`}>
				<Image
					src={p.src}
					alt={p.alt}
					width={p.portrait ? 400 : 600}
					height={p.portrait ? 600 : 400}
					fit="cover"
					widths={[400, 800]}
					sizes="(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw"
					format="webp"
					loading={i < 8 ? 'eager' : 'lazy'}
					decoding="async"
				/>
			</button>
		))
	}
</div>

<dialog id="lightbox" aria-label="Photo viewer">
	<button type="button" class="close" aria-label="Close">×</button>
	<button type="button" class="nav prev" aria-label="Previous photo">‹</button>
	<img alt="" />
	<button type="button" class="nav next" aria-label="Next photo">›</button>
</dialog>

<script>
	const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery .tile'));
	const box = document.querySelector<HTMLDialogElement>('#lightbox')!;
	const img = box.querySelector('img')!;
	let current = 0;

	function show(i: number) {
		current = (i + tiles.length) % tiles.length;
		const t = tiles[current];
		img.src = t.dataset.full!;
		img.alt = t.dataset.alt ?? '';
	}
	function open(i: number) {
		show(i);
		if (!box.open) box.showModal();
	}

	tiles.forEach((t, i) => t.addEventListener('click', () => open(i)));
	box.querySelector('.close')!.addEventListener('click', () => box.close());
	box.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
	box.querySelector('.next')!.addEventListener('click', () => show(current + 1));
	box.addEventListener('click', (e) => {
		if (e.target === box) box.close();
	});
	box.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});
	box.addEventListener('close', () => (img.src = ''));
</script>

<style>
	/* Two tile shapes (3:2 landscape, 2:3 portrait) at one row height, so every row lines up. */
	.gallery {
		--row: 170px;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	@media (min-width: 700px) {
		.gallery {
			--row: 240px;
		}
	}
	@media (min-width: 1100px) {
		.gallery {
			--row: 280px;
		}
	}
	.tile {
		display: block;
		height: var(--row);
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--line);
		cursor: zoom-in;
		overflow: hidden;
	}
	.tile.landscape {
		aspect-ratio: 3 / 2;
		flex: 3 1 calc(var(--row) * 1.5);
	}
	.tile.portrait {
		aspect-ratio: 2 / 3;
		flex: 2 1 calc(var(--row) * 0.667);
	}
	.tile img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.2s;
	}
	.tile:hover img {
		opacity: 0.88;
	}
	dialog {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(250, 250, 248, 0.97);
	}
	dialog[open] {
		display: grid;
		place-items: center;
	}
	dialog img {
		max-width: 92vw;
		max-height: 92vh;
		object-fit: contain;
	}
	dialog button {
		position: absolute;
		background: none;
		border: 0;
		color: var(--fg);
		font-size: 2.5rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.5rem 1rem;
		opacity: 0.6;
	}
	dialog button:hover {
		opacity: 1;
	}
	.close {
		top: 0.5rem;
		right: 0.75rem;
	}
	.nav {
		top: 50%;
		transform: translateY(-50%);
	}
	.prev {
		left: 0.5rem;
	}
	.next {
		right: 0.5rem;
	}
</style>
