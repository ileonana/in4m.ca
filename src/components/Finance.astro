---
// Bank of Canada Valet: daily average rates, published once per business day.
---

<section class="tile fin" id="finance" aria-labelledby="fin-title">
	<h2 class="group-title" id="fin-title">Rates <span class="src">Bank of Canada</span></h2>

	<div class="hero">
		<div class="label">1 CAD in CNY <span>人民币</span></div>
		<div class="num" data-role="cny">–</div>
		<div class="delta" data-role="cny-d"></div>
		<svg class="spark" data-role="spark" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true"></svg>
		<div class="range" data-role="range"></div>
	</div>

	<dl class="rows">
		<div>
			<dt>1 USD in CAD</dt>
			<dd data-role="usd">–</dd>
		</div>
		<div>
			<dt>Overnight rate</dt>
			<dd data-role="policy">–</dd>
		</div>
	</dl>

	<div class="foot" data-role="updated"></div>
</section>

<script>
	const REFRESH_MS = 60 * 60 * 1000; // the Bank publishes once a day
	const CACHE_KEY = 'fx-v1';
	const API = 'https://www.bankofcanada.ca/valet/observations';

	type Obs = { d: string; [series: string]: { v: string } | string };
	type Cached = { at: number; fx: Obs[]; policy: string };

	const root = document.getElementById('finance')!;
	const q = (role: string) => root.querySelector<HTMLElement>(`[data-role="${role}"]`)!;

	function readCache(): Cached | null {
		try {
			return JSON.parse(localStorage.getItem(CACHE_KEY) ?? 'null');
		} catch {
			return null;
		}
	}

	const val = (o: Obs, s: string) => {
		const x = o[s];
		return typeof x === 'object' ? Number(x.v) : NaN;
	};

	function render({ at, fx: raw, policy }: Cached, stale = false) {
		const fx = [...raw].sort((a, b) => a.d.localeCompare(b.d)); // the API returns newest first
		// Rate the user cares about is CNY per CAD, the inverse of the published CNY/CAD.
		const cny = fx.map((o) => ({ d: o.d, v: 1 / val(o, 'FXCNYCAD') })).filter((p) => isFinite(p.v));
		const last = cny[cny.length - 1];
		const prev = cny[cny.length - 2];
		q('cny').textContent = last.v.toFixed(4);
		const d = prev ? last.v - prev.v : 0;
		const el = q('cny-d');
		el.textContent = prev ? `${d >= 0 ? '▲' : '▼'} ${Math.abs(d).toFixed(4)} · ${last.d.slice(5)}` : last.d;
		el.dataset.dir = d > 0 ? 'up' : d < 0 ? 'down' : '';

		const vs = cny.map((p) => p.v);
		const lo = Math.min(...vs);
		const hi = Math.max(...vs);
		const span = hi - lo || 1;
		const pts = vs.map((v, i) => `${((i / (vs.length - 1)) * 120).toFixed(1)},${(29 - ((v - lo) / span) * 26).toFixed(1)}`);
		q('spark').innerHTML = `<polyline points="${pts.join(' ')}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`;
		q('range').textContent = `${vs.length}-day  L ${lo.toFixed(4)}  H ${hi.toFixed(4)}`;

		const usd = fx.map((o) => val(o, 'FXUSDCAD')).filter(isFinite);
		q('usd').textContent = usd[usd.length - 1].toFixed(4);
		q('policy').textContent = `${Number(policy).toFixed(2)}%`;

		const time = new Date(at).toLocaleTimeString('en-CA', { timeZone: 'America/Toronto', hour: 'numeric', minute: '2-digit' });
		const note = q('updated');
		note.classList.toggle('stale', stale);
		note.textContent = stale ? `Couldn't refresh · last updated ${time}` : `Updated ${time}`;
	}

	async function get(path: string) {
		const res = await fetch(`${API}/${path}`);
		if (!res.ok) throw new Error(String(res.status));
		return (await res.json()).observations as Obs[];
	}

	async function refresh() {
		const cached = readCache();
		if (cached && Date.now() - cached.at < REFRESH_MS) return render(cached);
		try {
			const [fx, pol] = await Promise.all([get('FXUSDCAD,FXCNYCAD/json?recent=30'), get('V39079/json?recent=1')]);
			const fresh: Cached = { at: Date.now(), fx, policy: String(val(pol[0], 'V39079')) };
			try {
				localStorage.setItem(CACHE_KEY, JSON.stringify(fresh));
			} catch {}
			render(fresh);
		} catch {
			if (cached) render(cached, true);
			else q('updated').textContent = 'Unavailable';
		}
	}

	refresh();
	setInterval(refresh, REFRESH_MS);
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) refresh();
	});
</script>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.group-title {
		margin: 0;
	}
	.src {
		margin-left: auto;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--muted);
	}
	.label span {
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: none;
	}
	.hero .num {
		margin-top: 0.35rem;
	}
	.delta {
		font-size: 0.75rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.delta[data-dir='up'] {
		color: var(--accent);
	}
	.delta[data-dir='down'] {
		color: var(--warn);
	}
	.spark {
		display: block;
		width: 100%;
		height: 2rem;
		margin-top: 0.7rem;
		color: var(--accent);
		opacity: 0.85;
	}
	.range {
		margin-top: 0.3rem;
		font-size: 0.7rem;
		color: var(--muted);
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.rows {
		margin: 0;
		border-top: 1px solid var(--line);
	}
	.rows > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.55rem 0;
		font-size: 0.85rem;
	}
	.rows > div + div {
		border-top: 1px solid var(--line);
	}
	dt {
		color: var(--muted);
	}
	dd {
		margin: 0;
		font-variant-numeric: tabular-nums;
	}
	.foot {
		margin-top: auto;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		opacity: 0.85;
	}
	.foot.stale {
		color: var(--danger);
		opacity: 1;
	}
</style>
