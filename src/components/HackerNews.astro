---
// Top Hacker News stories, fetched in the browser (Firebase API, no key).
---

<section class="tile hn" id="hn" aria-labelledby="hn-title">
	<h2 class="group-title" id="hn-title">Hacker News <span class="src">Top stories</span></h2>
	<ol class="list" data-role="list"><li class="empty">Loading…</li></ol>
	<div class="foot" data-role="updated"></div>
</section>

<script>
	const REFRESH_MS = 10 * 60 * 1000;
	const CACHE_KEY = 'hn-v1';
	const COUNT = 6;
	const API = 'https://hacker-news.firebaseio.com/v0';

	type Story = { id: number; title: string; url?: string; score: number; descendants?: number };
	type Cached = { at: number; stories: Story[] };

	const root = document.getElementById('hn')!;
	const list = root.querySelector<HTMLElement>('[data-role="list"]')!;
	const note = root.querySelector<HTMLElement>('[data-role="updated"]')!;

	function readCache(): Cached | null {
		try {
			return JSON.parse(localStorage.getItem(CACHE_KEY) ?? 'null');
		} catch {
			return null;
		}
	}

	function host(url?: string) {
		try {
			return url ? new URL(url).hostname.replace(/^www\./, '') : 'news.ycombinator.com';
		} catch {
			return '';
		}
	}

	function render({ at, stories }: Cached, stale = false) {
		list.replaceChildren(
			...stories.map((s) => {
				const li = document.createElement('li');
				const a = Object.assign(document.createElement('a'), {
					href: s.url ?? `https://news.ycombinator.com/item?id=${s.id}`,
					target: '_blank',
					rel: 'noopener noreferrer',
					textContent: s.title,
				});
				const meta = document.createElement('div');
				meta.className = 'meta';
				const comments = Object.assign(document.createElement('a'), {
					href: `https://news.ycombinator.com/item?id=${s.id}`,
					target: '_blank',
					rel: 'noopener noreferrer',
					textContent: `${s.descendants ?? 0} comments`,
				});
				meta.append(`${host(s.url)} · ${s.score} pts · `, comments);
				li.append(a, meta);
				return li;
			}),
		);
		const time = new Date(at).toLocaleTimeString('en-CA', { timeZone: 'America/Toronto', hour: 'numeric', minute: '2-digit' });
		note.classList.toggle('stale', stale);
		note.textContent = stale ? `Couldn't refresh · last updated ${time}` : `Updated ${time}`;
	}

	async function json(path: string) {
		const res = await fetch(`${API}/${path}.json`);
		if (!res.ok) throw new Error(String(res.status));
		return res.json();
	}

	async function refresh() {
		const cached = readCache();
		if (cached && Date.now() - cached.at < REFRESH_MS) return render(cached);
		try {
			const ids: number[] = (await json('topstories')).slice(0, COUNT);
			const items: (Story | null)[] = await Promise.all(ids.map((id) => json(`item/${id}`)));
			const stories = items.filter((s): s is Story => !!s && !!s.title);
			if (!stories.length) throw new Error('empty');
			const fresh: Cached = { at: Date.now(), stories };
			try {
				localStorage.setItem(CACHE_KEY, JSON.stringify(fresh));
			} catch {}
			render(fresh);
		} catch {
			if (cached) render(cached, true);
			else list.innerHTML = '<li class="empty">Unavailable</li>';
		}
	}

	refresh();
	setInterval(refresh, REFRESH_MS);
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) refresh();
	});
</script>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.group-title {
		margin: 0;
	}
	.src {
		margin-left: auto;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--muted);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: n;
	}
	.list :global(li) {
		counter-increment: n;
		display: grid;
		grid-template-columns: 1.4rem minmax(0, 1fr);
		padding: 0.55rem 0;
		font-size: 0.85rem;
		line-height: 1.4;
	}
	.list :global(li + li) {
		border-top: 1px solid var(--line);
	}
	.list :global(li)::before {
		content: counter(n);
		color: var(--muted);
		font-size: 0.7rem;
		padding-top: 0.15rem;
		font-variant-numeric: tabular-nums;
	}
	.list :global(li > *) {
		grid-column: 2;
	}
	.list :global(a) {
		text-decoration: none;
	}
	.list :global(li > a:hover) {
		color: var(--accent);
	}
	.list :global(.meta) {
		font-size: 0.7rem;
		color: var(--muted);
	}
	.list :global(.meta a:hover) {
		color: var(--fg);
		text-decoration: underline;
	}
	.list :global(li.empty)::before {
		content: none;
	}
	.list :global(li.empty) {
		display: block;
		color: var(--muted);
	}
	.foot {
		margin-top: auto;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		opacity: 0.85;
	}
	.foot.stale {
		color: var(--danger);
		opacity: 1;
	}
</style>
