---
import Base from '../layouts/Base.astro';
import Clock from '../components/Clock.astro';
import Weather from '../components/Weather.astro';
import GoTrain from '../components/GoTrain.astro';
import Finance from '../components/Finance.astro';
import HackerNews from '../components/HackerNews.astro';
import OnThisDay from '../components/OnThisDay.astro';
import Kid from '../components/Kid.astro';
import T from '../components/T.astro';

const title = 'in4m · Dashboard';
const description = 'A personal dashboard: time, weather, the GO train, rates and news, at a glance.';
---

<Base title={title} description={description}>
	<header class="masthead">
		<div class="lang" role="group" aria-label="Language · 语言">
			<button type="button" data-set-lang="en">EN</button>
			<button type="button" data-set-lang="zh" lang="zh-CN">中</button>
		</div>
		<h1 class="wordmark" aria-label="in4m">in<span>4</span>m</h1>
		<p class="greeting" id="greeting"><T zh="欢迎回来">Welcome back</T></p>
	</header>

	<!-- Bento grid: each tile is a self-contained component. Add new ones below.
	     lang="en" marks tiles whose content stays English in either language. -->
	<main class="bento">
		<div class="span-all"><Clock /></div>
		<div class="span-all"><Weather /></div>
		<div class="span-all"><GoTrain /></div>
		<div><Finance /></div>
		<div lang="en"><HackerNews /></div>
		<div lang="en"><OnThisDay /></div>
		<div class="span-all" lang="en"><Kid /></div>
	</main>
</Base>

<script>
	import { lang, onLang, setLang, type Lang } from '../i18n';

	const greetings = {
		en: ['Good night', 'Good morning', 'Good afternoon', 'Good evening'],
		zh: ['夜深了', '早上好', '下午好', '晚上好'],
	};

	// Time-of-day greeting in Toronto time.
	function greet() {
		const hour = Number(
			new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto', hour: '2-digit', hourCycle: 'h23' }).format(
				new Date(),
			),
		);
		const i = hour < 5 ? 0 : hour < 12 ? 1 : hour < 18 ? 2 : 3;
		document.getElementById('greeting')!.textContent = greetings[lang()][i];
	}

	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-lang]');
	function syncButtons() {
		for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.setLang === lang()));
	}
	for (const b of buttons) b.addEventListener('click', () => setLang(b.dataset.setLang as Lang));

	greet();
	syncButtons();
	onLang(() => {
		greet();
		syncButtons();
	});
</script>

<style>
	.masthead {
		position: relative;
		text-align: center;
		padding: clamp(2.5rem, 7vw, 4.5rem) var(--gutter) 1.25rem;
	}
	.wordmark {
		margin: 0;
		font-size: clamp(2.6rem, 8vw, 3.8rem);
		font-weight: 200;
		letter-spacing: -0.06em;
		line-height: 1;
	}
	.wordmark span {
		color: var(--accent);
		font-weight: 300;
		margin: 0 0.02em;
	}
	.greeting {
		margin: 1rem 0 0;
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.greeting:lang(zh) {
		font-size: 0.8rem;
		letter-spacing: 0.3em;
	}
	.greeting::before,
	.greeting::after {
		content: '';
		width: 1.75rem;
		height: 1px;
		background: linear-gradient(to right, transparent, var(--muted));
		opacity: 0.6;
	}
	.greeting::after {
		transform: scaleX(-1);
	}
	/* Language toggle: a small hairline pill, top right. The active side follows <html data-lang>. */
	.lang {
		position: absolute;
		top: 1rem;
		right: var(--gutter);
		display: flex;
		padding: 0.15rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
	}
	.lang button {
		font: inherit;
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1;
		min-width: 2.1rem;
		padding: 0.4rem 0.6rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.2s, background-color 0.2s;
	}
	.lang button:lang(zh) {
		font-size: 0.75rem;
		letter-spacing: 0;
	}
	.lang button:hover {
		color: var(--fg);
	}
	.lang button:focus-visible {
		outline: 1px solid var(--muted);
		outline-offset: 1px;
	}
	:root:not([data-lang='zh']) .lang [data-set-lang='en'],
	:root[data-lang='zh'] .lang [data-set-lang='zh'] {
		background: var(--inset);
		color: var(--fg);
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: 1.1rem;
		padding: 1rem var(--gutter) 4rem;
		max-width: 72rem;
		margin: 0 auto;
	}
	.bento > div {
		display: flex;
		min-width: 0;
	}
	.bento > div > :global(*) {
		flex: 1;
	}
	.span-all {
		grid-column: 1 / -1;
	}
</style>
