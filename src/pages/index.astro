---
import Base from '../layouts/Base.astro';
import Clock from '../components/Clock.astro';
import Weather from '../components/Weather.astro';
import GoTrain from '../components/GoTrain.astro';
import Finance from '../components/Finance.astro';
import HackerNews from '../components/HackerNews.astro';
import OnThisDay from '../components/OnThisDay.astro';

const title = 'in4m · Dashboard';
const description = 'A personal dashboard: time, weather and the GO train, at a glance.';
---

<Base title={title} description={description}>
	<header class="masthead">
		<h1 class="wordmark" aria-label="in4m">in<span>4</span>m</h1>
		<p class="greeting" id="greeting">Welcome back</p>
	</header>

	<!-- Bento grid: each tile is a self-contained component. Add new ones below. -->
	<main class="bento">
		<div class="span-all"><Clock /></div>
		<div class="span-all"><Weather /></div>
		<div class="span-all"><GoTrain /></div>
		<div><Finance /></div>
		<div><HackerNews /></div>
		<div><OnThisDay /></div>
	</main>
</Base>

<script>
	// Time-of-day greeting in Toronto time.
	const hour = Number(
		new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto', hour: '2-digit', hourCycle: 'h23' }).format(
			new Date(),
		),
	);
	const greeting = hour < 5 ? 'Good night' : hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
	document.getElementById('greeting')!.textContent = greeting;
</script>

<style>
	.masthead {
		text-align: center;
		padding: clamp(2.5rem, 7vw, 4.5rem) var(--gutter) 1.25rem;
	}
	.wordmark {
		margin: 0;
		font-size: clamp(2.6rem, 8vw, 3.8rem);
		font-weight: 200;
		letter-spacing: -0.06em;
		line-height: 1;
	}
	.wordmark span {
		color: var(--accent);
		font-weight: 300;
		margin: 0 0.02em;
	}
	.greeting {
		margin: 1rem 0 0;
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.greeting::before,
	.greeting::after {
		content: '';
		width: 1.75rem;
		height: 1px;
		background: linear-gradient(to right, transparent, var(--muted));
		opacity: 0.6;
	}
	.greeting::after {
		transform: scaleX(-1);
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: 1.1rem;
		padding: 1rem var(--gutter) 4rem;
		max-width: 72rem;
		margin: 0 auto;
	}
	.bento > div {
		display: flex;
		min-width: 0;
	}
	.bento > div > :global(*) {
		flex: 1;
	}
	.span-all {
		grid-column: 1 / -1;
	}
</style>
