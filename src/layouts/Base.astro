---
interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #f4f3ef;
		--bg-glow: #ffffff;
		--fg: #17181a;
		--muted: #86868b;
		--line: rgba(20, 20, 20, 0.08);
		--card: rgba(255, 255, 255, 0.72);
		--inset: rgba(20, 20, 20, 0.035);
		--shadow: 0 1px 1px rgba(20, 20, 20, 0.03), 0 12px 32px -16px rgba(20, 20, 20, 0.12);
		--accent: #2f7d5b;
		--warn: #b5583c;
		--danger: #d43b3b;
		--gutter: clamp(1rem, 4vw, 3rem);
		--radius: 1.5rem;
		--font:
			'Inter', system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
			'Microsoft YaHei', 'Noto Sans SC', sans-serif;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0d0e10;
			--bg-glow: #1a1c20;
			--fg: #ececee;
			--muted: #8b8d93;
			--line: rgba(255, 255, 255, 0.08);
			--card: rgba(255, 255, 255, 0.04);
			--inset: rgba(255, 255, 255, 0.04);
			--shadow: 0 1px 1px rgba(0, 0, 0, 0.3), 0 12px 32px -16px rgba(0, 0, 0, 0.6);
			--accent: #5fb890;
			--warn: #e0876a;
			--danger: #ff6b6b;
		}
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
		background: var(--bg);
	}
	body {
		margin: 0;
		min-height: 100vh;
		color: var(--fg);
		background:
			radial-gradient(60rem 30rem at 50% -10%, var(--bg-glow), transparent 70%), var(--bg);
		background-attachment: fixed;
		font-family: var(--font);
		font-size: 15px;
		line-height: 1.55;
		letter-spacing: -0.005em;
		font-feature-settings: 'cv11', 'ss03';
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
	a {
		color: inherit;
	}

	/* Shared tile language: glassy hairline card, quiet uppercase labels, light numerals. */
	.tile {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		padding: 1.4rem 1.75rem;
	}
	@media (max-width: 42rem) {
		.tile {
			padding: 1.25rem;
		}
	}
	.label {
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.label span {
		color: var(--accent);
		letter-spacing: 0.08em;
		margin-left: 0.25rem;
	}
	.num {
		font-size: clamp(2rem, 5vw, 2.6rem);
		font-weight: 300;
		letter-spacing: -0.045em;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.num small {
		font-size: 0.85rem;
		font-weight: 400;
		letter-spacing: 0;
		color: var(--muted);
		margin-left: 0.35rem;
	}
	.group-title {
		margin: 0 0 0.9rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--fg);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.group-title::before {
		content: '';
		width: 0.32rem;
		height: 0.32rem;
		border-radius: 50%;
		background: var(--accent);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.bento > div {
			animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}
		.bento > div:nth-child(2) {
			animation-delay: 0.07s;
		}
		.bento > div:nth-child(3) {
			animation-delay: 0.14s;
		}
	}
</style>
