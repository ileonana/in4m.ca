# Template for the NAS-local env file passed to the kid-digest container via
# `docker run --env-file`. Fill in real values in a copy of this file that
# lives OUTSIDE the repo on the NAS (e.g. /volume1/docker/kid-digest.env) --
# never commit a filled-in copy.

KID_NAME=
KID_DIGEST_ACCOUNTS=lawrence,wife

# Each account needs 2-Step Verification enabled on the Google account, then
# a 16-character App Password generated at https://myaccount.google.com/apppasswords
GMAIL_LAWRENCE_EMAIL=
GMAIL_LAWRENCE_APP_PASSWORD=

GMAIL_WIFE_EMAIL=
GMAIL_WIFE_APP_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

KID_DIGEST_PASSPHRASE=
